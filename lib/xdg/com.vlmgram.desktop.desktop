[Desktop Entry]
Name=vlmGram Desktop
Comment=Desktop version of vlmGram - ToS breaking Telegram client
TryExec=vlmGram
Exec=env DESKTOPINTEGRATION=1 GDK_BACKEND=x11 QT_QPA_PLATFORM=xcb WEBKIT_DISABLE_DMABUF_RENDERER=1 vlmGram -- %U
Icon=com.vlmgram.desktop
Terminal=false
StartupWMClass=vlmGram
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;
Keywords=tg;chat;im;messaging;messenger;sms;telegram;tdesktop;
Actions=quit;
DBusActivatable=true
SingleMainWindow=true
X-GNOME-UsesNotifications=true
X-GNOME-SingleWindow=true

[Desktop Action quit]
Exec=vlmGram -quit
Name=Quit vlmGram
Icon=application-exit
